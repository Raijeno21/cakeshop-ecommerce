// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserDetails {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String?
  lastName     String?
  mobileNumber String?
  address      String?
  profileImage String?
  role         Role     @default(USER)
  order Order[] @relation("UserOrder")
  cartItems CartItems[] @relation("UserCart")
  wishlist Wishlist[] @relation("UserWishlist")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Items {
  id String @id @default(uuid())
  productName String
  price Int
  rating Int
  image String
  inventoryStatus Int
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItems {
  id String @id @default(uuid())
  userID String
  productName String
  productId String
  image String
  quantity Int
  price Int
  isCheckout Boolean @default(false)
  inventoryStatus Int
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user UserDetails @relation("UserCart",fields: [userID],references: [id])
}
model Wishlist {
   id String @id @default(uuid())
  userID String
  productName String
  productId String
  image String
  price Int
  inventoryStatus Int
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user UserDetails @relation("UserWishlist",fields: [userID], references: [id])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid())
  userID          String
  productId       String
  productName     String
  image           String
  quantity        Int
  price     Int
  totalPrice          Int
  category        String
  orderStatus    OrderStatus @default(PENDING)
  paymentMethod   String?
  paymentId       String?
  shippingAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user UserDetails @relation("UserOrder", fields: [userID], references: [id])
}
